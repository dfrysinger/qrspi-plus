+@test "first-party prompt tmpfile has signal-cleanup trap on EXIT/INT/TERM" {
+  local script="$REPO_ROOT/scripts/run-codex-review.sh"
+  # Guard: the first-party dispatch block must install a trap referencing _fp_tmp.
