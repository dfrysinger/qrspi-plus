+  local cfg="$BATS_TEST_TMPDIR/config.md"
+  _write_routing_fixture "$cfg"
+  run _exec_resolve_tier "$cfg" "$agent" "high"
+  [ "$status" -eq 0 ]
+  [ "$output" = "high" ]
+}
