+  echo "$section" | grep -qE "Do NOT emit findings or sentinels"
+  echo "$section" | grep -qE "single-line text response"
+  echo "$section" | grep -qE "CONTRACT-CONFLICT:"
+  echo "$section" | grep -qE "End the turn"
+}
+
