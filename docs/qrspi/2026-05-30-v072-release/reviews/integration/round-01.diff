+}
+
+# ── Guard text references INCLUDE-BEGIN/INCLUDE-END markers ──────────────────
+
+@test "reviewer SKILL.md guard references INCLUDE-BEGIN" {
+  run grep -F 'INCLUDE-BEGIN' "$REVIEWER_SKILL"
