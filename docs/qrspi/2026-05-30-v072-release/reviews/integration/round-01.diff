+  # INT trap must carry the canonical interrupt exit code (130).
+  grep -q "trap 'rm -f \"\$_fp_tmp\" 2>/dev/null || true; exit 130' INT" "$script" \
+    || { echo "INT trap must include 'exit 130' for canonical interrupt exit code"; return 1; }
+  # TERM trap must carry the canonical termination exit code (143).
+  grep -q "trap 'rm -f \"\$_fp_tmp\" 2>/dev/null || true; exit 143' TERM" "$script" \
