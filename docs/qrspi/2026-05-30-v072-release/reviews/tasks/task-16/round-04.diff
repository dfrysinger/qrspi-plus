+  low:        { vendor: claude, model: claude-haiku-4.5 }
+  medium:     { vendor: claude, model: claude-sonnet-4.6 }
+  high:       { vendor: claude, model: claude-opus-4.7 }
+  extra-high: { vendor: claude, model: claude-opus-4.7-high }
+default_tier: medium
+```
