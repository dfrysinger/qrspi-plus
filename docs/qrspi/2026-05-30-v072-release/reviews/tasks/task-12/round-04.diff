+esac
+case "$IMPLEMENTER_COMMIT" in
+  -*) echo "round-prepare: --implementer-commit must not begin with '-' (got: $IMPLEMENTER_COMMIT)." >&2; exit 1 ;;
+esac
+case "$WORKTREE" in
