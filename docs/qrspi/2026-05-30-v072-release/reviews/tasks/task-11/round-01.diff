+    || { echo "dispatch_spec missing vendor"; cat "$manifest"; return 1; }
+  jq -e '.[0].dispatch_spec.model == "gpt-5-codex-canary"' "$manifest" >/dev/null \
+    || { echo "dispatch_spec.model does not match dispatched model"; cat "$manifest"; return 1; }
+
+  rm -rf "$TMP_DIR"
+}
