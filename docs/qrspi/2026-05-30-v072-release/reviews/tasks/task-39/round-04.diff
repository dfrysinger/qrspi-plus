+  [ "$status" -ne 0 ]
+  echo "$output" | grep -F '.claude-plugin/server.pem'
+  echo "$output" | grep -E -i 'denylist|secret|refused'
+  [ ! -e "$root/build/.claude-plugin/server.pem" ]
+}
