+  fail_block="$(awk '/On failure/{flag=1} /^7\. /{flag=0} flag' "$agent")"
+  echo "$success_block" | grep -qF 'actual_model:' \
+    || { echo "audit field absent from success-case sidecar frontmatter"; return 1; }
