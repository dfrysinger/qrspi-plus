+}
+
+# --- Canonicalization-failure case (fail-closed) ---------------------------
+
+@test "G16: unresolvable \$REPO_ROOT fails closed before any path is read" {
+  _g16_setup_fixtures
+  run env QRSPI_REPO_ROOT=/no/such/repo/root/anywhere "$WRAPPER" \
