++       --artifact-dir '$FIXTURE_DIR' \
++       --provider ctrl-test-prov \
++       --model test-model \
++       --output-file '$FIXTURE_DIR/out.txt'"
++  [ "$status" -eq 1 ]
++  [[ "$output" == *"header-validation"* ]]
