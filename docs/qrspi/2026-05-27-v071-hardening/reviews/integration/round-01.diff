++  # CR (0x0D) embedded in the key is a canonical CRLF-injection vector.
++  CTRL_TEST_KEY="sk-ok$(printf '\015')X-Injected: evil" QRSPI_ALLOW_LOCALHOST_BASE_URL=1 run bash -c \
++    "printf 'test-prompt\n' | '$DISPATCHER' \
