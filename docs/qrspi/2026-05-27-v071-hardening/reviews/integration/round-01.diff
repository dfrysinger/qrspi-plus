+   while [ "$_hi" -lt "${#HEADER_NAMES[@]}" ]; do
+     _hname="${HEADER_NAMES[$_hi]}"
+     _hval="${HEADER_VALUES[$_hi]}"
+-    # Use printf | grep -P for control-character detection.
