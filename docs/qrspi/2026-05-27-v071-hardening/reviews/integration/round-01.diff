++  case "$API_KEY_ENV" in
++    ''|*[!A-Za-z0-9_]*) die "key-resolution: api_key_env must be a valid shell identifier (for provider '$PROVIDER')" ;;
++  esac
+   if ! env | grep -q "^${API_KEY_ENV}="; then
