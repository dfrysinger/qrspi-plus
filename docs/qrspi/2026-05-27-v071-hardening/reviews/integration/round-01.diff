+       if (/:[[:space:]]*[|>][[:space:]]*$/) { in_scalar = 1 }
+-      else if (in_scalar && /^[^[:space:]]/ && !/^---$/) { in_scalar = 0 }
++      else if (in_scalar && /^[^[:space:]]/) { in_scalar = 0 }
