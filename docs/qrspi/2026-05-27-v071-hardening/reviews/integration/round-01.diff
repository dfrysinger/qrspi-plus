+-       printf '%s' "$_hval"  | grep -qP '[\x00-\x1f\x7f]' 2>/dev/null; then
+-      die "header-validation: default_headers for provider '$PROVIDER' contains a control character in header '$_hname'"
+-    fi
++    _control_char_check "$_hname" "$_hval"
+     _hi=$((_hi + 1))
+   done
