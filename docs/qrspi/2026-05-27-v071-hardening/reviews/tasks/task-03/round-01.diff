+  require_repo_root
+  local patterns_file="$REPO_ROOT/tests/unit/test-skill-md-content-patterns.bats"
+  [ -f "$patterns_file" ]
+  # After migration, the inline function definition must be absent.
+  ! grep -q "^extract_review_round()" "$patterns_file"
+}
