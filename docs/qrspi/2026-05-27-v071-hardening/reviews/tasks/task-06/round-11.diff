+# ---------------------------------------------------------------------------
+# Per-test setup — build a fresh temp directory with a mock REPO_ROOT skeleton.
+# ---------------------------------------------------------------------------
+
+setup() {
+  TMP_DIR="$(mktemp -d)"
+  export TMP_DIR
+
+  # Subject-code file required by --subject-code for dispatch invocations.
+  mkdir -p "$TMP_DIR/src"
